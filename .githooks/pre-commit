#!/usr/bin/env bash
# Prevent committing environment files and other sensitive secrets
set -euo pipefail

blocked_regex='(^|/)(ven\.env|\.env(\..*)?$|.*\.env(\.|$))'

# List staged files, skipping committed templates (e.g. ven.env.example)
staged=$(git diff --cached --name-only | grep -Eiv '\.(example|sample|template)$' || true)

if echo "$staged" | grep -Eiq "$blocked_regex"; then
  printf '\n[pre-commit] Blocked: environment file detected in the commit (ven.env/.env).\n' >&2
  echo "Add to .gitignore and use an example file instead (e.g., ven.env.example)." >&2
  exit 1
fi

exit 0
